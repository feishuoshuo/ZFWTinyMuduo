{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C+++ (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/example/example_test", // 你的测试程序路径
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunch": {
                "command": "bash",
                "args": [
                    "-c",
                    "g++ -g -std=c++17 ${file}"
                ]
            },
            "miDebuggerPath": "/usr/bin/gdb" // 你的 gdb 路径
        }
    ]
}